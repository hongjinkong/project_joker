# 접속 정보는 이 파일을 복사해 .env 로 쓴다. .env 는 .gitignore 로 커밋 차단(키 유출 1차 방어선).
# 상용 API 전환은 아래 3개(BASE_URL/API_KEY/모델명)만 바꾸면 된다 — 코드 수정 0줄.

# ★ 실제 모델로 실측하려면 아래를 local 로 바꾸세요 (mock 이면 네트워크 없이 가짜 데모만 돕니다)
JOKER_PROFILE=mock            # mock | local | openai | full_local
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama           # Ollama 는 아무 값이나. 상용 API 는 실제 키

VICTIM_MODEL=qwen2.5:3b-instruct   # 공격 대상 재현본 — 로컬 유지(리포트가 거짓말 안 하게)
RECON_MODEL=qwen2.5:3b-instruct
JUDGE_MODEL=qwen2.5:3b-instruct

# ── 혼합 배치(선택): victim=로컬 유지 + recon/judge 만 상용 API ──
# 아래 4줄 주석을 풀면 victim 은 위 로컬(Ollama)로, recon·judge 는 OpenAI 로 간다.
# 지시문 원문이 밖으로 나가는 건 recon 1회뿐 + 판정 정확도↑. (권장: gpt-5-mini)
# RECON_BACKEND=openai
# JUDGE_BACKEND=openai
# OPENAI_API_KEY=sk-...
# RECON_MODEL=gpt-5-mini
# JUDGE_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

JOKER_TEMPERATURE=0          # 진단은 0 고정(재현성)
JOKER_SEED=42
JOKER_MAX_CALLS=200          # 진단 1회 호출 상한(비용 방어)
JOKER_DB_PATH=joker.db
JOKER_ENV_PROFILE=macbook_m2_8gb   # 결과 행에 저장돼 재현 맥락이 됨
